# Copy this file to ".env" (next to manage.py) on the server and fill in the values.
# Never upload or commit your real .env – it holds your secrets.

# Production mode. Keep False on the live server.
DJANGO_DEBUG=False

# Long random value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=paste-a-long-random-value-here

# Signs the rotating QR codes. Use a DIFFERENT long random value from the secret key.
QR_JWT_SECRET=paste-another-long-random-value-here

# Your site address without https://, e.g. yourname.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=yourname.pythonanywhere.com

# Optional
# LIVE_POLL_SECONDS=30
# DJANGO_HSTS_SECONDS=2592000
# DJANGO_LOG_LEVEL=WARNING
